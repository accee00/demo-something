# SentinelQA Backend Configuration
PORT=5001
NODE_ENV=development

# Target Application URL (defaults to local React demo app or embedded store)
TARGET_APP_URL=http://localhost:5173

# Optional: Google Gemini API Key for dynamic LLM test synthesis & DOM healing
# If left empty, SentinelQA automatically falls back to its deterministic rule engine!
GEMINI_API_KEY=

# Optional: Atlassian Jira Cloud Configuration
# If left empty, SentinelQA uses its built-in realistic mock ticket bank
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=user@company.com
JIRA_API_TOKEN=your_jira_api_token

